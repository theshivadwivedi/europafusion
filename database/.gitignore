
# ==========================================
# Laravel Environment & Secrets
# ==========================================
.env
.env.*
!.env.example
.auth.json

# ==========================================
# Composer Dependencies
# ==========================================
/vendor/

# ==========================================
# Node.js Dependencies
# ==========================================
/node_modules/

# ==========================================
# Vite Build Files
# ==========================================
/public/build
/public/hot

# ==========================================
# Laravel Cache & Runtime Files
# ==========================================
/bootstrap/cache/*.php
/storage/*.key
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*

# Preserve required directory placeholders
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# ==========================================
# Database Local Files
# ==========================================
/database/*.sqlite
/database/*.sqlite3

*.sql.gz

# ==========================================
# Testing & Coverage
# ==========================================
.phpunit.result.cache
/coverage/

# ==========================================
# IDE & Editor Files
# ==========================================
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
*.tmp
*.bak
*.swp
npm-debug.log*
yarn-debug.log*
