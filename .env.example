#--------------------------------------------------------------------------
# EUROPA FUSION – environment configuration
# Copy to .env, then run: php artisan key:generate
#--------------------------------------------------------------------------

APP_NAME="EUROPA FUSION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public URL of the site, without trailing slash (used in emails, sitemap, canonical URLs)
APP_URL=https://europafusion.io
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

#--- Database (MySQL 8.x / MariaDB 10.6+) ---------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=europafusion
DB_USERNAME=europafusion
DB_PASSWORD=

#--- Sessions, cache & queue (all stored in MySQL – no Redis needed) -------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the site is served over HTTPS (recommended)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends notification emails during the request. Switch to "database"
# and run `php artisan queue:work` if your SMTP server is slow.
QUEUE_CONNECTION=sync

CACHE_STORE=database

#--- Email (REQUIRED for enquiry notifications) ----------------------------
# Until real SMTP credentials are set, "log" writes emails to storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@europafusion.io"
MAIL_FROM_NAME="${APP_NAME}"

#--- Website / company settings (config/site.php) --------------------------
# Inbox that receives new student enquiries and B2B partner requests
ENQUIRY_NOTIFY_EMAIL=contact@europafusion.io
# Send a confirmation email to the person who submitted a form (true/false)
ENQUIRY_SEND_ACK=true
SITE_PHONE="+91 99747 98803"
# Digits only, international format, used for wa.me links
SITE_WHATSAPP=919974798803
SITE_EMAIL=contact@europafusion.io
SOCIAL_INSTAGRAM=https://www.instagram.com/europafusion/
SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61580822580581
SOCIAL_LINKEDIN=https://www.linkedin.com/company/freie-admits/
# Leave empty to hide the YouTube icon
SOCIAL_YOUTUBE=

VITE_APP_NAME="${APP_NAME}"
